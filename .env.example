# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supports either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (new sb_publishable_...) or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
# Server-only secret key (sb_secret_... or service_role JWT) - NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here

# Loyalty Security Pepper (64-character random hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
LOYALTY_PEPPER=generate_a_secure_64_character_hex_secret_here
